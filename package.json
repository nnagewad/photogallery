{
  "name": "photogallery",
  "version": "1.0.0",
  "description": "Everyday Lens, a curated gallery of photographs by Nikin Nagewadia.",
  "main": "eleventy.config.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "update-gallery": "node scripts/update-gallery.js",
    "delete-photos": "node scripts/delete-photos.js",
    "watch:sass": "sass --watch src/scss:_site/css --style=compressed",
    "watch:eleventy": "eleventy --serve",
    "start": "concurrently \"npm run watch:sass\" \"npm run watch:eleventy\"",
    "build": "concurrently \"sass src/scss:_site/css --style=compressed\" \"eleventy\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nnagewad/photogallery.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/nnagewad/photogallery/issues"
  },
  "homepage": "https://github.com/nnagewad/photogallery#readme",
  "type": "module",
  "dependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@11ty/eleventy-img": "^6.0.4",
    "@11ty/eleventy-plugin-rss": "^2.0.4",
    "dotenv": "^17.2.1",
    "exifreader": "^4.31.2",
    "luxon": "^3.7.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "html-minifier-terser": "^7.2.0",
    "sass": "^1.91.0",
    "terser": "^5.43.1"
  }
}
