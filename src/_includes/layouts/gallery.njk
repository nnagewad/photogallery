{% extends 'layouts/base.njk' %}

{% block content %}
  <section class="photo">
    {% for photo in photogallery | reverse %}
      <img src="{{ photo.image }}" alt="{{ photo.altText }}" />  
      <a href="photo/{{ photo.filename | slugify }}">
        More information  
      </a>
    {% endfor %}
  </section>
{% endblock %}