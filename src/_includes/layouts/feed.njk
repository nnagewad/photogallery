{% extends 'layouts/base.njk' %}

{% block content %}
  <section class="feed">
    {% for photo in photofeed %}
      <article>
        <img src="{{ photo.image }}" alt="{{ photo.alt }}" />
        <h2>{{ photo.title }}</h2>
      </article>
    {% endfor %}
  </section>
  
  {% include 'partials/pagination.njk' %}

{% endblock %}
