{% extends 'layouts/base.njk' %}

{% block content %}
  <article id='{{ photo.title | slugify }}' class='photo-details' data-pagefind-body>
    <h1 class='font-size-2 website-page--title grid-container'>{{ photo.title | updateApostrophe }}</h1>
    <figure class="flex-container--wrap">
      <img 
        src="{{ photo.image }}"
        alt="{{ photo.alt }}"
        class="
          {% if photo.dimensions.width < photo.dimensions.height %}
            photo photo-orientation--portrait
          {% elif photo.dimensions.width == photo.dimensions.height %}
            photo photo-orientation--square
          {% elif photo.dimensions.width > photo.dimensions.height %}
            photo photo-orientation--landscape
          {% endif %}
        "
      />
      <figcaption class="photograph-details">
        <dl>
          <div class='list-horizontal horizontal-gap--2'>
            <dt class='data-key' data-pagefind-ignore>Date:</dt>
            <dd class='data-value'>
              <time datetime="{{ photo.dateTaken | apiToISO }}">
                {{ photo.dateTaken | apiToDate | upper }}
              </time>
            </dd>
          </div>
          <div class='list-horizontal horizontal-gap--2'>
            <dt class='data-key' data-pagefind-ignore>Time:</dt>
            <dd class='data-value'>
              <time datetime="{{ photo.dateTaken | apiToISO }}">
                {{ photo.dateTaken | apiToTime | upper }}
              </time>
            </dd>
          </div>
          {% if photo.gps != null %}
            <div class='list-horizontal horizontal-gap--2'>
              <dt class='data-key' data-pagefind-ignore>Location:</dt>
              <dd class='data-value'>
                <span>{% if photo.localized != null %}{{ photo.localized | upper }}, {% endif %}{{ photo.country | upper }}</span> <a href="https://www.google.com/maps?q={{ photo.gps.lat }},{{ photo.gps.lon }}" rel="noopener noreferrer" target="_blank" class="view-map-link">(view in Google Maps)</a>
              </dd>
            </div>
          {% endif %}
          <div class='list-horizontal horizontal-gap--2'>
            <dt class='data-key' data-pagefind-ignore>Camera:</dt>
            <dd class='data-value'>{{ photo.camera }}</dd>
          </div>
          <div class='list-horizontal horizontal-gap--2'>
            <dt class='data-key' data-pagefind-ignore>Lens:</dt>
            <dd class='data-value'>{{ photo.lens }}</dd>
          </div>
          <div class='list-horizontal horizontal-gap--2'>
            <dt class='data-key' data-pagefind-ignore>Aperture:</dt>
            <dd class='data-value'>{{ photo.aperture }}</dd>
          </div>
          <div class='list-horizontal horizontal-gap--2'>
            <dt class='data-key' data-pagefind-ignore>ISO:</dt>
            <dd class='data-value'>{{ photo.iso }}</dd>
          </div>
          <div class='list-horizontal horizontal-gap--2'>
            <dt class='data-key' data-pagefind-ignore>Shutter speed:</dt>
            <dd class='data-value'>{{ photo.shutterSpeed }}</dd>
          </div>
          <div class='list-horizontal horizontal-gap--2'>
          <dt class='data-key' data-pagefind-ignore>Tags:</dt>
          <dd>
            <ul class='list-horizontal horizontal-gap--4'>
              {% for tag in photo.tags %}
                <li class='data-value'>{{ tag | upper }}</li>
              {% endfor %}
            </ul>
          </dd>
        </div>
        </dl>
      </figcaption>
    </figure>
  </article>
  {% include 'partials/pagination.njk' %}
{% endblock %}