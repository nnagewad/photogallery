<article id="{{ photo.title | slugify }}">
  <figure>
    <img src="{{ photo.image }}" alt="{{ photo.alt }}" />
    <figcaption>
      <h2>{{ photo.title | updateApostrophe }}</h2>
      {% if layout == 'layouts/photo-feed.njk' %}
        <a href="post/{{ photo.title | slugify }}/index.html">More information<span class="visually-hidden"> about this photo</span></a>
      {% endif %}
      {% if layout == 'layouts/photo.njk' %}
        <h3>Information</h3>
        <dl>
          <div>
            <dt>Date and time</dt>
            <dd>
              <time datetime="{{ photo.dateTaken | apiToISO }}">{{ photo.dateTaken | apiToDate }} at {{ photo.dateTaken | apiToTime }}</time>
            </dd>
          </div>
          {% if photo.gps != null %}
            <div>
              <dt>Location</dt>
              <dd>
                <a href="https://www.google.com/maps?q={{ photo.gps.lat }},{{ photo.gps.lon }}"  rel="noopener noreferrer" target="_blank">{% if photo.localized != null %}{{ photo.localized }}, {% endif %}{{ photo.country }}</a> (open Google Maps in a new tab)
              </dd>
            </div>
          {% endif %}
          <div>
            <dt>Camera</dt>
            <dd>{{ photo.camera }}</dd>
          </div>
          <div>
            <dt>Lens</dt>
            <dd>{{ photo.lens }}</dd>
          </div>
          <div>
            <dt>Aperture</dt>
            <dd>{{ photo.aperture }}</dd>
          </div>
          <div>
            <dt>ISO</dt>
            <dd>{{ photo.iso }}</dd>
          </div>
          <div>
            <dt>Shutter speed</dt>
            <dd>{{ photo.shutterSpeed }}</dd>
          </div>
        </dl>

        <h3>Tags</h3>
        <ul>
          {% for tag in photo.tags %}
            <li>{{ tag }}</li>
          {% endfor %}
        </ul>
      {% endif %}
    </figcaption>
  </figure>
</article>