{% if layout == 'layouts/photo-feed.njk' %}
  <article id='{{ photo.title | slugify }}' class='individual-photo--feed'>
    <figure>
      <a href="post/{{ photo.title | slugify }}/index.html">
        <span class="visually-hidden">More information about the photo, entitled: {{ photo.title | updateApostrophe }}</span>
        {% include 'partials/photo-path.njk' %}
      </a>
    </figure>
  </article>
{% endif %}

{% if layout == 'layouts/photo.njk' %}
  <article id="{{ photo.title | slugify }}">
    <h1>
      <span class='photo-title'>{{ photo.title | updateApostrophe }}</span>
    </h1>
    <figure>
      {% include 'partials/photo-path.njk' %}
    </figure>
    <figcaption>
      <dl>
        <div>
          <dt>Date and time:</dt>
          <dd>
            <time datetime="{{ photo.dateTaken | apiToISO }}">{{ photo.dateTaken | apiToDate }} at {{ photo.dateTaken | apiToTime }}</time>
          </dd>
        </div>
        {% if photo.gps != null %}
          <div>
            <dt>Location:</dt>
            <dd>
              <a href="https://www.google.com/maps?q={{ photo.gps.lat }},{{ photo.gps.lon }}"  rel="noopener noreferrer" target="_blank">{% if photo.localized != null %}{{ photo.localized }}, {% endif %}{{ photo.country }}</a> (open Google Maps in a new tab)
            </dd>
          </div>
        {% endif %}
        <div>
          <dt>Camera:</dt>
          <dd>{{ photo.camera }}</dd>
        </div>
        <div>
          <dt>Lens:</dt>
          <dd>{{ photo.lens }}</dd>
        </div>
        <div>
          <dt>Aperture:</dt>
          <dd>{{ photo.aperture }}</dd>
        </div>
        <div>
          <dt>ISO:</dt>
          <dd>{{ photo.iso }}</dd>
        </div>
        <div>
          <dt>Shutter speed:</dt>
          <dd>{{ photo.shutterSpeed }}</dd>
        </div>
      </dl>
      <span>Tags:</span>
      <ul>
        {% for tag in photo.tags %}
          <li>{{ tag }}</li>
        {% endfor %}
      </ul>
    </figcaption>
  </article>
{% endif %}