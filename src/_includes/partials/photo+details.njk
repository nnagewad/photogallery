{% if layout == 'layouts/photo-feed.njk' %}
  <article id='{{ photo.title | slugify }}' class='individual-photo--feed'>
    <a href="/post/{{ photo.title | slugify }}/index.html">
      <span class="visually-hidden">More information about the photo, entitled: {{ photo.title | updateApostrophe }}</span>
      <figure>
        {% include 'partials/photo-path.njk' %}
      </figure>
      <span>{{ photo.title | updateApostrophe }}</span>
    </a>
  </article>
{% endif %}

{% if layout == 'layouts/photo.njk' %}
  <article id='{{ photo.title | slugify }}' class='individual-photo--page'>
    <h1 class='font-size-2 title-spacing'>{{ photo.title | updateApostrophe }}</h1>
    <figure>
      {% include 'partials/photo-path.njk' %}
    </figure>
    <figcaption>
      <dl>
        <div class='list-horizontal horizontal-gap--2'>
          <dt class='bold'>Date and time:</dt>
          <dd>
            <time datetime="{{ photo.dateTaken | apiToISO }}">
              {{ photo.dateTaken | apiToDate }} at {{ photo.dateTaken | apiToTime }}
            </time>
          </dd>
        </div>
        {% if photo.gps != null %}
          <div class='list-horizontal horizontal-gap--2'>
            <dt class='bold'>Location:</dt>
            <dd>
              <a href="https://www.google.com/maps?q={{ photo.gps.lat }},{{ photo.gps.lon }}"  rel="noopener noreferrer" target="_blank">
                {% if photo.localized != null %}{{ photo.localized }}, {% endif %}{{ photo.country }}</a>
                <span class='font-size--1'>(open Google Maps<span class='visually-hidden'> in a new tab or the app if installed on the device</span>)</span>
            </dd>
          </div>
        {% endif %}
        <div class='list-horizontal horizontal-gap--2'>
          <dt class='bold'>Camera:</dt>
          <dd>{{ photo.camera }}</dd>
        </div>
        <div class='list-horizontal horizontal-gap--2'>
          <dt class='bold'>Lens:</dt>
          <dd>{{ photo.lens }}</dd>
        </div>
        <div class='list-horizontal horizontal-gap--2'>
          <dt class='bold'>Aperture:</dt>
          <dd>{{ photo.aperture }}</dd>
        </div>
        <div class='list-horizontal horizontal-gap--2'>
          <dt class='bold'>ISO:</dt>
          <dd>{{ photo.iso }}</dd>
        </div>
        <div class='list-horizontal horizontal-gap--2'>
          <dt class='bold'>Shutter speed:</dt>
          <dd>{{ photo.shutterSpeed }}</dd>
        </div>
      </dl>

       <div class='list-horizontal horizontal-gap--2'>
        <span class='bold'>Tags:</span>
        <ul class='list-horizontal horizontal-gap--3'>
          {% for tag in photo.tags %}
            <li>{{ tag | capitalize }}</li>
          {% endfor %}
        </ul>
       </div>
    </figcaption>
  </article>
{% endif %}