<nav class="pagination">
  <ul>
    {% if pagination.href.previous %}
      <li>
        <svg xmlns="http://www.w3.org/2000/svg" class="navigation-icons" width="16.8" height="13.1" aria-hidden="true" focusable="false" viewBox="0 0 16.8 13.1"> 
          <path d="M6.7,0L0,6.7l6.7,6.4,1.4-1.4-4.2-4h12.9v-2H3.8L8.1,1.4S6.7,0,6.7,0Z"/>
        </svg>
        <a href="{{ pagination.href.previous }}">
          Previous {% if layout == 'layouts/photogallery.njk' %}page{% elif layout == 'layouts/photo.njk' %}photo{% endif %}
        </a>  
      </li>
    {% endif %}

    {% if pagination.href.next %}
      <li>
        <svg xmlns="http://www.w3.org/2000/svg" class="navigation-icons" width="16.8" height="13.1" aria-hidden="true" focusable="false" viewBox="0 0 16.8 13.1">
          <path d="M10.1,0l-1.4,1.4,4.3,4.3H0v2h12.9l-4.2,4,1.4,1.4,6.7-6.4L10.1,0Z"/>
        </svg>
        <a href="{{ pagination.href.next }}">
          Next {% if layout == 'layouts/photogallery.njk' %}page{% elif layout == 'layouts/photo.njk' %}photo{% endif %}
        </a>
      </li>
    {% endif %}
  </ul>
</nav>