<h1 class="title-spacing">
  {% if pagination.href.previous or pagination.href.next %}
    <span class="caption-with-headline website-title">
      <span class="headline-caption">Page {{ pagination.pageNumber + 1 }} <span class="visually-hidden">of</span></span>
      <span class="font-size-2">{{ site.siteName }}</span>
    </span>
  {% else %}
    <span class="font-size-2 website-title">{{ site.siteName }}</span>
  {% endif %}
</h1>