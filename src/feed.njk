---json
{
  "permalink": "feed.xml",
  "eleventyExcludeFromCollections": true,
  "metadata": {
    "description": "A collection of photos I’ve taken."
  }
}
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ site.language or page.lang }}">
  <title>{{ site.siteName }}</title>
  <subtitle>{{ metadata.description }}</subtitle>
  <link href="{{ permalink | htmlBaseUrl(site.url) }}" rel="self" />
  <link href="{{ site.url | addPathPrefixToFullUrl }}" />
  <updated>{{ collections.posts | getNewestCollectionItemDate | dateToRfc3339 }}</updated>
  <id>{{ site.url | addPathPrefixToFullUrl }}</id>
  <author>
    <name>{{ site.fullName }}</name>
  </author>
  {%- for post in collections.posts | reverse %}
    {%- set absolutePostUrl %}{{ post.url | htmlBaseUrl(site.url) }}{% endset %}
    <entry>
      <title>{{ post.data.title }}</title>
      <link href="{{ absolutePostUrl }}" />
      <updated>{{ post.data.photo.dateAdded }}</updated>
      <id>{{ absolutePostUrl }}</id>
      <content type="html"><![CDATA[
        <img src="{{ site.url }}/img/photos/{{ post.data.photo.filename }}" alt="{{ post.data.photo.alt | safe }}" />
        <dl>
          <dt>Date</dt>
          <dd>{{ post.data.photo.dateTaken | apiToDate }}</dd>
          <dt>Time</dt>
          <dd>{{ post.data.photo.dateTaken | apiToTime }}</dd>
          {% if post.data.photo.gps != null %}
            <dt>Location</dt>
            <dd>
              <a href="https://www.google.com/maps?q={{ post.data.photo.gps.lat }},{{ post.data.photo.gps.lon }}" rel="noopener noreferrer" target="_blank">
                {% if post.data.photo.localized != null %}{{ post.data.photo.localized }}, {% endif %}
                {{ post.data.photo.country }}
              </a> (open Google Maps in a new tab)
            </dd>
          {% endif %}
          <dt>Camera</dt>
          <dd>{{ post.data.photo.camera }}</dd>
          <dt>Lens</dt>
          <dd>{{ post.data.photo.lens }}</dd>
          <dt>Aperture</dt>
          <dd>{{ post.data.photo.aperture }}</dd>
          <dt>ISO</dt>
          <dd>{{ post.data.photo.iso }}</dd>
          <dt>Shutter speed</dt>
          <dd>{{ post.data.photo.shutterSpeed }}</dd>
          <dt>Tags</dt>
          <dd>
            <ul>
              {% for tag in post.data.photo.tags %}
                <li>{{ tag | safe }}</li>
              {% endfor %}
            </ul>
          </dd>
        </dl>
      ]]></content>
    </entry>
  {%- endfor %}
</feed>